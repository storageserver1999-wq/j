{
  "name": "propeller-engine",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && install-electron && electron .",
    "package:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.propellerengine.editor",
    "productName": "Propeller Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Propeller Engine"
    }
  }
}
